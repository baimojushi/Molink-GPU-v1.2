# Official Black Forest Labs API path used by scripts/run_bfl_hanging_flux_pipeline.py
export BFL_API_KEY=""
export BFL_API_BASE="https://api.bfl.ai"

# Keep two production capabilities only.
export BFL_ERASE_ENDPOINT="/v1/flux-tools/erase-v1"
export BFL_FLUX2_ENDPOINT="/v1/flux-2-max"   # default production model; switch to /v1/flux-2-pro to reduce cost

export BFL_ERASE_DILATE_PIXELS="10"
export BFL_TIMEOUT_S="180"
export BFL_POLL_INTERVAL_S="1"
export BFL_MAX_RETRIES="3"

# Flux.2 input image encoding. Default raw base64; set 1 only if your account endpoint expects data URLs.
export BFL_FLUX2_IMAGE_AS_DATA_URL="0"

# Hard-paste exit review. Reuses the existing OpenAI-compatible VLM env when high-risk candidates require review.
export HARDPASTE_EXIT_REVIEW_MODE="auto"
export VLM_PROVIDER="openai_compatible"
export VLM_API_URL=""
export VLM_API_KEY=""
export VLM_MODEL=""
