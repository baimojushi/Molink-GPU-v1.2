# Official Black Forest Labs API path used by scripts/run_bfl_hanging_flux_pipeline.py
export BFL_API_KEY=""
export BFL_API_BASE="https://api.bfl.ai"

# Keep two production capabilities only.
export BFL_ERASE_ENDPOINT="/v1/flux-tools/erase-v1"
export BFL_FLUX2_ENDPOINT="/v1/flux-2-max"   # default production model; switch to /v1/flux-2-pro to reduce cost

export BFL_ERASE_DILATE_PIXELS="10"
export BFL_TIMEOUT_S="180"
export BFL_POLL_INTERVAL_S="1"
export BFL_MAX_RETRIES="3"

# Flux.2 input image encoding. Default raw base64; set 1 only if your account endpoint expects data URLs.
export BFL_FLUX2_IMAGE_AS_DATA_URL="0"

# Hard-paste exit review. Reuses the existing OpenAI-compatible VLM env when high-risk candidates require review.
export HARDPASTE_EXIT_REVIEW_MODE="auto"
export VLM_PROVIDER="openai_compatible"
export VLM_API_URL=""
export VLM_API_KEY=""
export VLM_MODEL=""

# GPT Image 2 VIP third-party relay for final render.
# The cleanup/erase step still uses BFL erase-v1.
# The final render step calls API易 /v1/images/edits and enforces the product mask locally:
# crop the flux2 edit-mask bbox, submit that crop as image=图1, then composite the result back through the mask.
export APIYI_API_KEY=""
export APIYI_API_BASE="https://api.apiyi.com/v1"
export APIYI_GPT_IMAGE_MODEL="gpt-image-2-vip"
export APIYI_GPT_IMAGE_SIZE="auto"         # edit docs recommend auto; optional fixed VIP size, e.g. 2048x1152 or 3840x2160
# export APIYI_GPT_IMAGE_RESPONSE_FORMAT="url"  # leave unset for default b64_json; url requires image2_OSS routing
export APIYI_GPT_IMAGE_TIMEOUT_S="300"
export APIYI_GPT_IMAGE_MAX_RETRIES="3"
export APIYI_GPT_IMAGE_COMPRESS_INPUTS="1"
export APIYI_GPT_IMAGE_MAX_INPUT_BYTES="10000000"
export APIYI_GPT_IMAGE_RESIZE_TO_INPUT="1"
# wall_rgb_only preserves GPT Image render pixels and only corrects surrounding wall RGB;
# use photometric_composite only when you explicitly want local locked-texture reconstruction.
export APIYI_GPT_IMAGE_MASK_EDIT_MODE="wall_rgb_only"
export APIYI_GPT_IMAGE_MASK_CROP_PADDING_PX="48"
export APIYI_GPT_IMAGE_MASK_COMPOSITE_FEATHER_PX="4"
export APIYI_GPT_IMAGE_ALLOW_UNMASKED_FALLBACK="0"

# Final postprocess: wall_rgb_only keeps provider render and avoids re-pasting frame/core/locked texture.
export MOLINK_FINAL_PHOTOMETRIC_LOCK="1"
export MOLINK_FINAL_POSTPROCESS_MODE="wall_rgb_only"
