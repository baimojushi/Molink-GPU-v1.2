# ============ GPU worker 环境变量（AutoDL 实例）============

# —— 业务端连接 ——
MOLINK_WS_URL=wss://www.molink.art/api/gpu/worker-connect
WORKER_SECRET=与业务端一致的同一随机串

# —— 实例身份与关机 ——
AUTODL_INSTANCE_ID=                 # 由 AutoDL startup env 注入，自关机用
AUTODL_TOKEN=                       # AutoDL API Token（worker 自关机用）
AUTODL_API_BASE=https://www.autodl.com/api/v1
AUTODL_PATH_STOP=/instance/shutdown
GPU_MODEL=TITAN Xp                  # 该实例 GPU 型号（用于业务端优先级）
GPU_COUNT=1
IDLE_TIMEOUT_S=300                  # 空闲多少秒后自关机

# —— 三段服务地址（同机默认）——
METRIC3D_URL=http://127.0.0.1:6006
SEMANTIC_URL=http://127.0.0.1:6011
HANGING_URL=http://127.0.0.1:6010
VLM_MODE=auto
PIPELINE_HTTP_TIMEOUT_S=600

# —— 渲染 ——
# 默认最终渲染走 API易 gpt-image-2-vip；cleanup/erase 仍使用 BFL erase-v1。
# GPT Image 2 VIP 无 mask 字段，worker 默认启用本地 mask 裁剪/回贴来约束局部重绘。
BFL_API_KEY=
APIYI_API_KEY=
APIYI_API_BASE=https://api.apiyi.com/v1
APIYI_GPT_IMAGE_MODEL=gpt-image-2-vip
APIYI_GPT_IMAGE_SIZE=auto
APIYI_GPT_IMAGE_TIMEOUT_S=300
# wall_rgb_only preserves GPT Image render pixels and only corrects surrounding wall RGB.
APIYI_GPT_IMAGE_MASK_EDIT_MODE=wall_rgb_only
APIYI_GPT_IMAGE_MASK_CROP_PADDING_PX=48
APIYI_GPT_IMAGE_MASK_COMPOSITE_FEATHER_PX=4
APIYI_GPT_IMAGE_ALLOW_UNMASKED_FALLBACK=0

# Final postprocess; wall_rgb_only avoids hard-paste/locked-texture reapplication.
MOLINK_FINAL_PHOTOMETRIC_LOCK=1
MOLINK_FINAL_POSTPROCESS_MODE=wall_rgb_only

# —— R2（与业务端同一套配置）——
R2_ACCOUNT_ID=
R2_BUCKET=artworks
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_ENDPOINT=
